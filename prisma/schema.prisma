generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Transaction pooler (6543, ?pgbouncer=true) - 런타임
  directUrl = env("DIRECT_URL")   // Session pooler (5432) - migrate 전용
}

// 포트폴리오 프로필 (싱글턴, id 고정 "me")
// interests: 한 줄에 하나 "주제 - 설명" / skills: 지금은 화면에 안 씀
// ...En 필드는 영어 페이지(메인 /)용 - 비어 있으면 한국어 값을 그대로 보여줌
model Profile {
  id            String   @id @default("me")
  photo         String?
  name          String?
  nameEn        String?
  slogan        String?
  sloganEn      String?
  tagline       String?
  taglineEn     String?
  affiliation   String?
  affiliationEn String?
  bio           String?
  bioEn         String?
  interests     String?
  interestsEn   String?
  skills        String?
  email         String?
  github        String?
  scholar       String?
  cvUrl         String?
  updatedAt     DateTime @updatedAt
}

// 포트폴리오 섹션 항목 - type이 섹션 (project/education/experience/certification, lib/history.ts 참고)
model HistoryEntry {
  id            String   @id @default(cuid())
  type          String
  title         String
  titleEn       String?
  org           String
  orgEn         String?
  period        String
  sortDate      DateTime
  description   String?
  descriptionEn String?
  link          String?
  tags          String? // 쉼표로 구분
  thumbnail     String? // 프로젝트 썸네일 (JPEG data URL)
  createdAt     DateTime @default(now())
}
