generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// 블로그 글
model Post {
  id        String    @id @default(cuid())
  slug      String    @unique // URL에 쓰이는 고유 경로
  title     String
  excerpt   String?
  content   String
  published Boolean   @default(true) // false면 목록/상세에서 비공개
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  category String @default("blog") // study | tech | blog
}

// 글에 달리는 댓글 (글 삭제 시 함께 삭제됨)
model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}

// 실시간 접속자 수 집계를 위한 방문자 세션 기록
model Presence {
  sessionId String   @id
  lastSeen  DateTime @default(now())
}

model Profile {
  id        String   @id @default("me")
  photo     String?
  name      String?
  tagline   String?
  bio       String?
  updatedAt DateTime @updatedAt
}

model HistoryEntry {
  id          String   @id @default(cuid())
  type        String
  title       String
  org         String
  period      String
  sortDate    DateTime
  description String?
  createdAt   DateTime @default(now())
}