generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Transaction pooler (6543, ?pgbouncer=true) - 런타임
  directUrl = env("DIRECT_URL")   // Session pooler (5432) - migrate 전용
}

// 포트폴리오 프로필 (싱글턴, id 고정 "me")
// interests: 한 줄에 하나 "주제 - 설명" / skills: 지금은 화면에 안 씀
// ...En 필드는 영어 페이지(메인 /)용 - 비어 있으면 한국어 값을 그대로 보여줌
model Profile {
  id            String   @id @default("me")
  photo         String?
  name          String?
  nameEn        String?
  slogan        String?
  sloganEn      String?
  tagline       String?
  taglineEn     String?
  affiliation   String?
  affiliationEn String?
  bio           String?
  bioEn         String?
  interests     String?
  interestsEn   String?
  skills        String?
  email         String?
  github        String?
  scholar       String?
  cvUrl         String?
  updatedAt     DateTime @updatedAt
}

// 포트폴리오 섹션 항목 - type이 섹션 (project/education/experience/certification, lib/history.ts 참고)
model HistoryEntry {
  id            String   @id @default(cuid())
  type          String
  title         String
  titleEn       String?
  org           String
  orgEn         String?
  period        String
  sortDate      DateTime
  description   String?
  descriptionEn String?
  link          String?
  tags          String? // 쉼표로 구분
  thumbnail     String? // 프로젝트 썸네일 (JPEG data URL)
  createdAt     DateTime @default(now())
}

// 블로그 카테고리 - 관리자가 /blog에서 추가. 글이 남아 있으면 삭제되지 않음
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  posts     Post[]
}

// 블로그 글 - 옛 블로그 때 만든 Post 테이블을 이어서 사용
// categoryId가 있는 글만 /blog에 보임. 옛 글은 categoryId가 비어 있어 DB에만 남아 있음
// category 글자 칸은 옛 글 전용
model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?
  content      String
  published    Boolean   @default(true)
  category     String    @default("blog")
  categoryId   String?
  categoryRef  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags         String? // 쉼표로 구분
  thumbnail    String? // 썸네일 (JPEG data URL)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
